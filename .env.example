# ─────────────────────────────────────────────────────────────────────
# DeskPet 环境变量样例 — 复制为 .env 并按需填值（.env 已被 .gitignore）
#
# 大部分变量都有合理默认；只有运行 release / CI / relay edition 时才必填。
# 详见 RELEASE.md（发布相关）+ QUICKSTART.md（dev 启动）。
# ─────────────────────────────────────────────────────────────────────


# ─── Backend ─────────────────────────────────────────────────────────

# Backend HTTP/WS 服务端口。worktree 隔离时改这个防端口冲突。
# 默认 8100。
DESKPET_BACKEND_PORT=8100

# Backend 仓库目录（绝对路径）。Tauri 拉起 Python 子进程时需要知道
# backend/ 在哪。dev-start.ps1 / dev-worktree.ps1 自动设。
# 留空 = Tauri 用编译时常量解析。
DESKPET_BACKEND_DIR=

# Backend Python interpreter（绝对路径，通常是 venv 里的 python.exe）。
# 留空 = 用 PATH 上第一个 python。
DESKPET_PYTHON=

# 用户数据目录（数据库 / keychain 落盘位置 / 模型缓存）。
# 留空 = 用 platformdirs 的默认（Win: %APPDATA%\deskpet）。
# 设了就用它，worktree 隔离时改这个防互相污染。
DESKPET_USER_DATA_DIR=

# 用户缓存目录（运行时临时文件 / HF 模型 cache）。
# 留空 = platformdirs 默认（Win: %LocalAppData%\deskpet）。
DESKPET_USER_CACHE_DIR=

# 模型权重根目录（faster-whisper / BGE-M3 / silero-vad）。
# 留空 = <USER_DATA_DIR>/models/。setup_models.py 默认下载到这里。
DESKPET_MODEL_ROOT=

# ffmpeg.exe 路径（TTS / VAD 用）。留空 = PATH 上第一个 ffmpeg。
DESKPET_FFMPEG=

# LibreOffice soffice 路径（office skill 用于 PPT/Word/Excel 渲染）。
# 留空 = PATH 上第一个 soffice。
DESKPET_SOFFICE_PATH=

# Dev 模式开关。设为 "1" 启用更详细日志 + 跳过 NVIDIA precheck。
# 生产 frozen build 应留空（默认 prod 行为）。
DESKPET_DEV_MODE=

# Dev 根目录（多 worktree 时 supervisor self-resolve 用）。
# 留空 = 用 cwd 推断。
DESKPET_DEV_ROOT=

# 顶层配置 toml 文件路径（覆盖默认 config.toml）。
# 留空 = 用 backend/ 同级的 config.toml。
DESKPET_CONFIG=

# Context 1M 重构开关（实验性，默认关）。
# 设 "v1" 启用 Phase 1 上下文管理；空 = legacy 行为。
DESKPET_CTX_V=


# ─── Frontend / Tauri ────────────────────────────────────────────────

# Vite dev server 端口。worktree 隔离时改这个。
# 默认 5173。
DESKPET_VITE_PORT=5173


# ─── 控制通道认证 ────────────────────────────────────────────────────

# Backend WS 控制通道共享密钥。Tauri 前端 + 后端必须用同一个值。
# Dev 模式下未设默认随机生成；prod 必填，长度 >= 32 chars。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
DESKPET_SHARED_SECRET=


# ─── Relay edition only（OSS manual 用户忽略） ────────────────────────

# Relay edition LLM API key（用户登录后由 relay 服务下发 + 写入
# OS keychain；backend 通过本变量从 keychain 读出来）。
# OSS / manual 用户**不填**——自己在 Settings 面板填 provider key 即可。
DESKPET_CLOUD_API_KEY=


# ─── Release / CI only（本地开发不填） ────────────────────────────────

# Windows 代码签名证书 thumbprint。仅 release.ps1 / build-msi.ps1 使用。
# 见 docs/signing.md。
DESKPET_CERT_THUMBPRINT=

# Tauri updater minisign 私钥（多行 PEM-like 文本）。
# 仅 release.yml 用；从 GitHub Actions repo secret 注入。
# 本地构建不需要——release.ps1 的 -NoSign 跳过签名。
TAURI_SIGNING_PRIVATE_KEY=

# 上述私钥的 passphrase（可选；生成时设了才填）。
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
