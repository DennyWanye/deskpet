# Relay edition build flag (WI-R1, beta-100 付费版).
#
# Loaded by Vite when invoked with `--mode relay` (see package.json
# `dev:relay` / `build:relay`). Selects RelayAuthAdapter in
# `src/auth/index.ts` — login + 中转站 provider auto-config.
#
# The OSS default build (`npm run build`, no mode) does NOT load this
# file → VITE_AUTH_EDITION is undefined → adapter falls back to "manual".
VITE_AUTH_EDITION=relay

# Relay 服务器 base URL（OSS 占位 — 真实 URL 写 .env.relay.local，已被
# *.local gitignore 排除）。RelayAuthAdapter 的 DEFAULT_BASE_URL 也是这
# 个 placeholder，dev/prod 必须 override 否则 DNS 失败、登录显示"网络
# 连接失败"（2026-05-30 bug）。
VITE_RELAY_BASE_URL=https://your-llm-relay.example.com
