# Tauri frontend env template — copy to .env.local for overrides.

# ============================================================
# Pet rendering backend selector (S5 Live2D removal 2026-05-29)
# ============================================================
#   sprite (default, only shipping backend) — self-rendered Canvas2D
#     character, 100% original code, zero copyright risk.
#
# Removed in S5:
#   live2d — pixi-live2d-display + cubismcore + Hiyori (deleted)
#
# Future:
#   mesh — WebGL2 mesh-deformation renderer (optional upgrade slice).
#
# Change requires `tauri dev` restart (resolved once at component mount).
VITE_PET_ENGINE=sprite
